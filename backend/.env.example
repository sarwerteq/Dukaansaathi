PORT=4000

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated list of origins allowed to call this API (your frontend domain)
CORS_ORIGIN=http://localhost:4000
# Reserved for a future managed-Postgres migration. Leave unset for now -
# setting this to a postgres:// URL will make the server refuse to start,
# since Postgres support isn't implemented yet (see project notes).
# DATABASE_URL=

# Path to the SQLite database file
DATABASE_FILE=./data/dukaansaathi.db

# Used only by the seed script, to create one demo shop + owner login
DEMO_SHOP_NAME=Sharma General Store
DEMO_OWNER_NAME=Rakesh Sharma
DEMO_PHONE=9999999999
DEMO_PASSWORD=demo1234
